# LOGH7 실행 설정 예시. 작성: Peppone Choi (peppone-choi).
# .env: 실행 설정 / .env.local: 실제 키. 우선순위: 프로세스 환경 > .env.local > .env.
# 이 예시에는 실제 비밀값을 넣지 않는다.

# 선택형 국가 정의 DB. V1/V2/V3 마이그레이션과 국가 정의 가져오기 후 연결한다.
# 설정하면 DB가 국가 정의/색상의 원천이다. 시작 전 DB 검증에 실패하면 서버를 시작하지 않는다.
# DB 정의는 파일 세계 백업에 포함되지 않는다. 별도로 백업/복원한다. docs/server/country-catalog.md 참고.
# 비밀번호는 .env.local 또는 프로세스 환경에만 넣는다. 기존 월드 파일을 자동 이행하지 않는다.
LOGH7_DEFINITIONS_JDBC_URL=
LOGH7_DEFINITIONS_DB_USER=
LOGH7_DEFINITIONS_DB_PASSWORD=

# TypeSafe Jev는 무지휘 NPC 함정의 사격 표적 선택에 사용한다. 실제 키는 .env.local에 넣는다.
# 키가 비어 있으면 기본 AI를 사용한다. 변경한 실행 설정은 서버 재시작 때 읽는다.
LOGH7_JEV_API_KEY=
LOGH7_JEV_BASE_URL=https://api.typesafe.ai
LOGH7_JEV_MODEL=jev-latest

# NPC 전술 교신 대사: none | openai_compatible. 모델 ID와 호환 서버의 /v1 주소를 입력한다.
# 키가 비어 있으면 기본 대사를 쓴다. 키를 무시하는 로컬 Ollama에는 ollama 같은 임의 값을 쓸 수 있다.
LOGH7_LLM_TYPE=none
LOGH7_LLM_MODEL=
LOGH7_LLM_BASE_URL=
LOGH7_LLM_API_KEY=

# 외부 AI별 요청 한도. 한 프로세스에서 같은 어댑터를 쓰는 모든 세션이 한도를 공유한다.
LOGH7_AI_TIMEOUT_MS=2000
LOGH7_AI_MAX_IN_FLIGHT=2
LOGH7_AI_INTERVAL_MS=15000

# 로컬 운영의 기본 주소. 기존 실행 스크립트의 환경 변수가 우선한다.
LOGH7_BIND_ADDRESS=127.0.0.1
LOGH7_GAME_PORT=47900
LOGH7_OPS_PORT=47901
LOGH7_UPDATE_PORT=47902
LOGH7_SESSION_PORT=47903

# 선택 사항. 가입 내부 API와 웹은 같은 호스트에서 루프백으로 통신한다.
# LOGH7_REGISTRATION_PORT=47904
# 아래 두 값은 웹 프로세스에 전달한다. HTTPS 주소는 Caddy에도 전달한다.
# LOGH7_PORTAL_ORIGIN=https://accounts.example.com
# LOGH7_GAME_HOST=192.0.2.10

# 여러 월드를 한 프로세스의 로비에서 선택한다. 빈 값은 기존 단일 세션 방식.
# 포트와 상태 저장 폴더는 세션마다 달라야 한다. 계정과 운영자 설정은 공통이다.
LOGH7_SESSIONS_FILE=
# 공통 계정 평판. 빈 값은 세션 설정 파일 옆 account-fame.properties를 사용한다.
LOGH7_ACCOUNT_FAME_FILE=
# Windows에서 여러 세션의 파일 저장을 쓸 때 지정한다. 디렉터리의 전원 장애 내구성은 OS에 맡긴다.
# LOGH7_SESSION_DIRECTORY_SYNC=files-only
